# Copy to .env and fill in. Never commit .env.
# The web UI and the demo API need none of this: `go run .` is enough to try them.

# ── Server ────────────────────────────────────────────────
PORT=8080
ENVIRONMENT=development          # development | production
# In production the service REFUSES to start without API_KEYS
# (or ALLOW_UNAUTHENTICATED=true, which you should not need).
API_KEYS=change-me-1,change-me-2 # comma-separated; sent as the X-API-Key header
CORS_ALLOWED_ORIGINS=            # e.g. https://crm.example.com,https://shop.example.com
DEMO_MODE=                       # true | false. Default: on, except in production

# ── AI and search (needed for real enrichment) ────────────
ANTHROPIC_API_KEY=your_claude_api_key
BRAVE_SEARCH_API_KEY=your_brave_search_key
UPCITEMDB_API_KEY=               # optional: barcode lookups
PDF_READER_MODEL=                # optional overrides for datasheet reading
PDF_MAX_DOCS_PER_PRODUCT=
PDF_MAX_MB=
PDF_MAX_TOKENS=

# ── Catalog database (SQL Server) ─────────────────────────
DB_SERVER=your_sql_server_host
DB_DATABASE=your_database
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_PORT=1433

# ── Cache (Redis, TLS) ────────────────────────────────────
REDIS_HOST=your_redis_host
REDIS_PORT=6380
REDIS_PASSWORD=your_redis_password
ENVIRONMENT_REDIS=               # prefix that keeps environments apart in a shared Redis
REDIS_ALLOW_INSECURE=            # "true" only for local development (plaintext fallback)

# ── Image storage (Azure Blob) ────────────────────────────
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_KEY=your_storage_key
AZURE_CONTAINER_NAME=product-images
TENANT_ID=your_tenant_id         # path prefix inside the container

# ── Notifications ─────────────────────────────────────────
ENRICHMENT_NOTIFY_EMAILS=        # comma-separated approvers
SENDGRID_APIKEY=
NOTIFY_FROM_EMAIL=noreply@example.com
NOTIFY_FROM_NAME=Catalog Enrichment
PORTAL_URL=http://localhost:8080 # base URL used in e-mail links
QUEUE_PATH=/#queue               # path appended to PORTAL_URL

CATALOG_UTC_OFFSET_HOURS=-5      # offset used for LastModifiedDate written on approval

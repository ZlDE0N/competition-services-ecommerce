# ===========================================
# CONFIGURACIÓN PARA DESPLIEGUE QA
# ===========================================

# Configuración del servidor
PORT=8080
ENVIRONMENT=production

# API Keys (obligatorias para funcionalidad de IA)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Database configuration
DB_SERVER=your_sql_server_host
DB_DATABASE=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_PORT=1433

# Redis configuration (obligatorio para cache)
REDIS_HOST=your_redis_host
REDIS_PORT=6380
REDIS_PASSWORD=your_redis_password

# Azure Storage configuration (para subida de imágenes)
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_KEY=your_storage_key
AZURE_CONTAINER_NAME=product-images

# Tenant configuration
TENANT_ID=your_tenant_id